{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)"
    ],
    "ask": [
      "Bash(git remote add *)",
      "Bash(git remote set-url *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-push.sh",
            "timeout": 10,
            "statusMessage": "Checking git push target"
          }
        ]
      }
    ]
  }
}
